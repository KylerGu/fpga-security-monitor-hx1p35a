
set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_rst_n }				{ LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # KEY1

set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

set_pin_assignment	{ I_button[0] }			{ LOCATION = A9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # KEY2: cycle
set_pin_assignment	{ I_button[1] }			{ LOCATION = B9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # KEY3: return RAW

set_pin_assignment	{ O_screen_pwm } 		{ LOCATION = R11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment	{ O_tmds_ch0_p }		{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }		{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }		{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }		{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }



set_pin_assignment {I_key4} {LOCATION=C7; IOSTANDARD=LVCMOS33; PULLTYPE=PULLUP;}
set_pin_assignment {I_setup} {LOCATION=A4; IOSTANDARD=LVCMOS33; PULLTYPE=PULLUP;}
set_pin_assignment {O_security_led[0]} {LOCATION=D10; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8;}
set_pin_assignment {O_security_led[1]} {LOCATION=E10; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8;}
set_pin_assignment {O_security_led[2]} {LOCATION=C6; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8;}
set_pin_assignment {O_security_led[3]} {LOCATION=D6; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8;}

# Board buzzer: low drives PNP transistor, high is silent; SW5 is hardware mute.
set_pin_assignment {O_buzzer_n} {LOCATION=C12; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=PULLUP;}

# SW2: auto exposure enable (up = 1 = on).
set_pin_assignment {I_ae_switch} {LOCATION=B4; IOSTANDARD=LVCMOS33; PULLTYPE=PULLUP;}

# SW3 focus enable; SW4 either stable transition resets reference.
set_pin_assignment {I_focus_switch} {LOCATION=E11; IOSTANDARD=LVCMOS33; PULLTYPE=PULLUP;}
set_pin_assignment {I_focus_reset} {LOCATION=D11; IOSTANDARD=LVCMOS33; PULLTYPE=PULLUP;}
